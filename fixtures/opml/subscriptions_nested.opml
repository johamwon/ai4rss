<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>River OPML Fixture</title>
  </head>
  <body>
    <outline text="技术" title="技术">
      <outline text="AI &amp; 工具" title="AI &amp; 工具">
        <outline type="rss" text="Example AI" title="Example AI"
          xmlUrl="HTTPS://EXAMPLE.TEST:443/feed.xml"
          htmlUrl="https://example.test/" />
      </outline>
    </outline>
    <outline text="新闻" title="新闻">
      <outline type="rss" text="Duplicate" xmlUrl="https://example.test/feed.xml" />
      <outline type="rss" text="Invalid" xmlUrl="file:///private/feed.xml" />
    </outline>
    <outline type="rss" text="Ungrouped" title="Ungrouped"
      xmlUrl="https://second.test/rss" />
  </body>
</opml>
